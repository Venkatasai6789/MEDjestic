# MEDjestic Environment Configuration
# Copy this file to .env and fill in values

# ============================================
# AI Service URL
# ============================================
# Local development:
VITE_AI_API_URL=http://localhost:7860

# Hugging Face Spaces deployment (example):
# VITE_AI_API_URL=https://your-username-medjestic-ai.hf.space

# ============================================
# Express Backend
# ============================================
PORT=5000
JWT_SECRET=your_jwt_secret_here

# ============================================
# Groq API (optional - for chatbot)
# ============================================
# GROQ_API_KEY=your_groq_key_here

# ============================================
# Hugging Face (for deployment only - NEVER expose in frontend)
# ============================================
# HF_TOKEN=your_huggingface_token_here
